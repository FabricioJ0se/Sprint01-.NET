@page "/moradores"
@inject HttpClient Http
@inject IJSRuntime JSRuntime

<PageTitle>Moradores - Portaria Light</PageTitle>

<div class="container-fluid">
    <!-- Cabeçalho -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="text-primary mb-1">
                <i class="fas fa-users me-2"></i>Gerenciar Moradores
            </h2>
            <p class="text-muted">Cadastro e controle de moradores do condomínio</p>
        </div>
        <button class="btn btn-primary btn-lg" @onclick="ShowCriarModal">
            <i class="fas fa-plus me-2"></i>Novo Morador
        </button>
    </div>

    <!-- Cards de Estatísticas -->
    <div class="row mb-4">
        <div class="col-xl-3 col-md-6">
            <div class="card bg-primary text-white">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div class="flex-grow-1">
                            <h4 class="mb-0">@moradores.Count</h4>
                            <p class="mb-0">Total de Moradores</p>
                        </div>
                        <div class="flex-shrink-0">
                            <i class="fas fa-users fa-2x opacity-50"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="card bg-success text-white">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div class="flex-grow-1">
                            <h4 class="mb-0">@moradores.Count(m => m.IdApartamento <= 3)</h4>
                            <p class="mb-0">Bloco A</p>
                        </div>
                        <div class="flex-shrink-0">
                            <i class="fas fa-building fa-2x opacity-50"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="card bg-warning text-dark">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div class="flex-grow-1">
                            <h4 class="mb-0">@moradores.Count(m => m.IdApartamento > 3 && m.IdApartamento <= 6)</h4>
                            <p class="mb-0">Bloco B</p>
                        </div>
                        <div class="flex-shrink-0">
                            <i class="fas fa-building fa-2x opacity-50"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="card bg-info text-white">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div class="flex-grow-1">
                            <h4 class="mb-0">@moradores.Count(m => m.IdApartamento > 6)</h4>
                            <p class="mb-0">Bloco C</p>
                        </div>
                        <div class="flex-shrink-0">
                            <i class="fas fa-building fa-2x opacity-50"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Card da Tabela -->
    <div class="card shadow-sm border-0">
        <div class="card-header bg-white py-3">
            <h5 class="card-title mb-0 text-dark">
                <i class="fas fa-list me-2"></i>Lista de Moradores
            </h5>
        </div>
        <div class="card-body p-0">
            @if (isLoading)
            {
                <div class="text-center py-5">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Carregando...</span>
                    </div>
                    <p class="text-muted mt-2">Carregando moradores...</p>
                </div>
            }
            else if (!moradores.Any())
            {
                <div class="text-center py-5">
                    <i class="fas fa-users fa-3x text-muted mb-3"></i>
                    <h5 class="text-muted">Nenhum morador cadastrado</h5>
                    <p class="text-muted">Clique no botão acima para adicionar o primeiro morador.</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover table-striped mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-4">ID</th>
                                <th>Morador</th>
                                <th>Contato</th>
                                <th>Apartamento</th>
                                <th class="text-center pe-4">Ações</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var morador in moradores)
                            {
                                <tr class="align-middle">
                                    <td class="ps-4 fw-bold text-primary">#@morador.IdMorador</td>
                                    <td>
                                        <div class="d-flex align-items-center">
                                            <div class="flex-shrink-0">
                                                <div class="bg-success rounded-circle d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
                                                    <i class="fas fa-user text-white"></i>
                                                </div>
                                            </div>
                                            <div class="flex-grow-1 ms-3">
                                                <h6 class="mb-0">@morador.Nome</h6>
                                                <small class="text-muted">ID: @morador.IdMorador</small>
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        <i class="fas fa-phone me-2 text-muted"></i>@morador.Contato
                                    </td>
                                    <td>
                                        <span class="badge bg-primary">
                                            <i class="fas fa-building me-1"></i>#@morador.IdApartamento
                                        </span>
                                    </td>
                                    <td class="text-center pe-4">
                                        <div class="btn-group btn-group-sm" role="group">
                                            <button class="btn btn-outline-warning" @onclick="() => EditarMorador(morador)" title="Editar">
                                                <i class="fas fa-edit"></i>
                                            </button>
                                            <button class="btn btn-outline-danger" @onclick="() => DeletarMorador(morador.IdMorador)" title="Excluir">
                                                <i class="fas fa-trash"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

<!-- Modal -->
@if (showModal)
{
    <div class="modal show d-block" style="background-color: rgba(0,0,0,0.5);" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content shadow-lg border-0">
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title">
                        <i class="fas @(moradorEdit.IdMorador == 0 ? "fa-plus" : "fa-edit") me-2"></i>
                        @(moradorEdit.IdMorador == 0 ? "Novo Morador" : "Editar Morador")
                    </h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="FecharModal"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">
                            <i class="fas fa-user me-2 text-muted"></i>Nome Completo
                        </label>
                        <input @bind="moradorEdit.Nome" class="form-control" placeholder="Digite o nome do morador" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">
                            <i class="fas fa-phone me-2 text-muted"></i>Contato
                        </label>
                        <input @bind="moradorEdit.Contato" class="form-control" placeholder="Digite o telefone de contato" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">
                            <i class="fas fa-building me-2 text-muted"></i>ID do Apartamento
                        </label>
                        <input @bind="moradorEdit.IdApartamento" type="number" class="form-control" placeholder="Número do apartamento" />
                    </div>
                </div>
                <div class="modal-footer border-0">
                    <button type="button" class="btn btn-outline-secondary" @onclick="FecharModal">
                        <i class="fas fa-times me-2"></i>Cancelar
                    </button>
                    <button type="button" class="btn btn-primary" @onclick="SalvarMorador">
                        <i class="fas @(moradorEdit.IdMorador == 0 ? "fa-save" : "fa-check") me-2"></i>
                        @(moradorEdit.IdMorador == 0 ? "Criar" : "Salvar")
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<!-- Toast -->
@if (showToast)
{
    <div class="position-fixed bottom-0 end-0 p-3" style="z-index: 11">
        <div class="toast show" role="alert">
            <div class="toast-header @(toastType == "success" ? "bg-success text-white" : "bg-danger text-white")">
                <i class="fas @(toastType == "success" ? "fa-check-circle" : "fa-exclamation-circle") me-2"></i>
                <strong class="me-auto">@(toastType == "success" ? "Sucesso" : "Erro")</strong>
                <button type="button" class="btn-close btn-close-white" @onclick="FecharToast"></button>
            </div>
            <div class="toast-body">
                @toastMessage
            </div>
        </div>
    </div>
}

@code {
    public class Morador
    {
        public int IdMorador { get; set; }
        public string Nome { get; set; } = string.Empty;
        public string Contato { get; set; } = string.Empty;
        public int IdApartamento { get; set; }
    }

    private List<Morador> moradores = new();
    private Morador moradorEdit = new();
    private bool showModal = false;
    private bool showToast = false;
    private string toastMessage = "";
    private string toastType = "success";
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        await CarregarMoradores();
    }

    private async Task CarregarMoradores()
    {
        try
        {
            isLoading = true;
            StateHasChanged();
            
            var response = await Http.GetAsync("api/Morador");
            
            if (response.IsSuccessStatusCode)
            {
                moradores = await response.Content.ReadFromJsonAsync<List<Morador>>() ?? new List<Morador>();
            }
            else
            {
                MostrarToast("Erro ao carregar moradores", "error");
            }
        }
        catch (Exception ex)
        {
            MostrarToast($"Erro: {ex.Message}", "error");
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private void ShowCriarModal() { moradorEdit = new Morador(); showModal = true; }
    private void FecharModal() { showModal = false; }

    private void EditarMorador(Morador morador)
    {
        moradorEdit = new Morador 
        { 
            IdMorador = morador.IdMorador,
            Nome = morador.Nome,
            Contato = morador.Contato,
            IdApartamento = morador.IdApartamento
        };
        showModal = true;
    }

    private async Task SalvarMorador()
    {
        if (string.IsNullOrWhiteSpace(moradorEdit.Nome) || string.IsNullOrWhiteSpace(moradorEdit.Contato))
        {
            MostrarToast("Preencha todos os campos obrigatórios!", "error");
            return;
        }

        try
        {
            if (moradorEdit.IdMorador == 0)
            {
                // POST - Criar novo
                var response = await Http.PostAsJsonAsync("api/Morador", moradorEdit);
                
                if (response.IsSuccessStatusCode)
                {
                    MostrarToast("Morador criado com sucesso!", "success");
                    showModal = false;
                    await CarregarMoradores();
                }
                else
                {
                    MostrarToast("Erro ao criar morador", "error");
                }
            }
            else
            {
                // PUT - Atualizar existente
                var response = await Http.PutAsJsonAsync($"api/Morador/{moradorEdit.IdMorador}", moradorEdit);
                
                if (response.IsSuccessStatusCode)
                {
                    MostrarToast("Morador atualizado com sucesso!", "success");
                    showModal = false;
                    await CarregarMoradores();
                }
                else
                {
                    MostrarToast("Erro ao atualizar morador", "error");
                }
            }
        }
        catch (Exception ex)
        {
            MostrarToast($"Erro: {ex.Message}", "error");
        }
    }

    private async Task DeletarMorador(int id)
    {
        var confirmed = await JSRuntime.InvokeAsync<bool>("confirm", "Tem certeza que deseja excluir este morador?");
        if (confirmed)
        {
            try
            {
                var response = await Http.DeleteAsync($"api/Morador/{id}");
                
                if (response.IsSuccessStatusCode)
                {
                    MostrarToast("Morador excluído com sucesso!", "success");
                    await CarregarMoradores();
                }
                else
                {
                    MostrarToast("Erro ao excluir morador", "error");
                }
            }
            catch (Exception ex)
            {
                MostrarToast($"Erro: {ex.Message}", "error");
            }
        }
    }

    private void MostrarToast(string mensagem, string tipo)
    {
        toastMessage = mensagem;
        toastType = tipo;
        showToast = true;
        StateHasChanged();
    }

    private void FecharToast()
    {
        showToast = false;
        StateHasChanged();
    }
}