@page "/apartamentos"
@inject HttpClient Http
@inject IJSRuntime JSRuntime

<PageTitle>Apartamentos - Portaria Light</PageTitle>

<div class="container-fluid">
    <!-- Cabeçalho -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="text-primary mb-1">
                <i class="fas fa-building me-2"></i>Gerenciar Apartamentos
            </h2>
            <p class="text-muted">Cadastre e gerencie os apartamentos do condomínio</p>
        </div>
        <button class="btn btn-primary btn-lg" @onclick="ShowCriarModal">
            <i class="fas fa-plus me-2"></i>Novo Apartamento
        </button>
    </div>

    <!-- Card da Tabela -->
    <div class="card shadow-sm border-0">
        <div class="card-header bg-white py-3">
            <h5 class="card-title mb-0 text-dark">
                <i class="fas fa-list me-2"></i>Lista de Apartamentos
            </h5>
        </div>
        <div class="card-body p-0">
            @if (isLoading)
            {
                <div class="text-center py-5">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Carregando...</span>
                    </div>
                    <p class="text-muted mt-2">Carregando apartamentos...</p>
                </div>
            }
            else if (!apartamentos.Any())
            {
                <div class="text-center py-5">
                    <i class="fas fa-building fa-3x text-muted mb-3"></i>
                    <h5 class="text-muted">Nenhum apartamento cadastrado</h5>
                    <p class="text-muted">Clique no botão acima para adicionar o primeiro apartamento.</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover table-striped mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-4">
                                    <i class="fas fa-hashtag me-2"></i>ID
                                </th>
                                <th>
                                    <i class="fas fa-tower-broadcast me-2"></i>Torre
                                </th>
                                <th>
                                    <i class="fas fa-cube me-2"></i>Bloco
                                </th>
                                <th>
                                    <i class="fas fa-door-closed me-2"></i>Número
                                </th>
                                <th class="text-center pe-4">
                                    <i class="fas fa-cogs me-2"></i>Ações
                                </th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var apartamento in apartamentos)
                            {
                                <tr class="align-middle">
                                    <td class="ps-4 fw-bold text-primary">#@apartamento.IdApartamento</td>
                                    <td>
                                        <span class="badge bg-secondary">@(apartamento.Torre?.ToString() ?? "N/A")</span>
                                    </td>
                                    <td>
                                        <span class="badge bg-info text-dark">@apartamento.Bloco</span>
                                    </td>
                                    <td>
                                        <span class="fw-semibold">@apartamento.Numero</span>
                                    </td>
                                    <td class="text-center pe-4">
                                        <div class="btn-group btn-group-sm" role="group">
                                            <button class="btn btn-outline-warning" 
                                                    @onclick="() => EditarApartamento(apartamento)"
                                                    title="Editar apartamento">
                                                <i class="fas fa-edit"></i>
                                            </button>
                                            <button class="btn btn-outline-danger" 
                                                    @onclick="() => DeletarApartamento(apartamento.IdApartamento)"
                                                    title="Excluir apartamento">
                                                <i class="fas fa-trash"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

<!-- Modal para Criar/Editar -->
@if (showModal)
{
    <div class="modal show d-block" style="background-color: rgba(0,0,0,0.5);" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content shadow-lg border-0">
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title">
                        <i class="fas @(apartamentoEdit.IdApartamento == 0 ? "fa-plus" : "fa-edit") me-2"></i>
                        @(apartamentoEdit.IdApartamento == 0 ? "Criar Apartamento" : "Editar Apartamento")
                    </h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="FecharModal"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-semibold">
                                <i class="fas fa-tower-broadcast me-2 text-muted"></i>Torre
                            </label>
                            <input @bind="apartamentoEdit.Torre" type="number" class="form-control" 
                                   placeholder="Número da torre" />
                            <div class="form-text">Opcional</div>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-semibold">
                                <i class="fas fa-cube me-2 text-muted"></i>Bloco
                            </label>
                            <input @bind="apartamentoEdit.Bloco" class="form-control" 
                                   placeholder="Ex: A, B, C..." />
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">
                            <i class="fas fa-door-closed me-2 text-muted"></i>Número do Apartamento
                        </label>
                        <input @bind="apartamentoEdit.Numero" class="form-control" 
                               placeholder="Ex: 101, 202, 305..." />
                    </div>
                </div>
                <div class="modal-footer border-0">
                    <button type="button" class="btn btn-outline-secondary" @onclick="FecharModal">
                        <i class="fas fa-times me-2"></i>Cancelar
                    </button>
                    <button type="button" class="btn btn-primary" @onclick="SalvarApartamento">
                        <i class="fas @(apartamentoEdit.IdApartamento == 0 ? "fa-save" : "fa-check") me-2"></i>
                        @(apartamentoEdit.IdApartamento == 0 ? "Criar" : "Salvar")
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<!-- Toast para Notificações -->
@if (showToast)
{
    <div class="position-fixed bottom-0 end-0 p-3" style="z-index: 11">
        <div class="toast show" role="alert">
            <div class="toast-header @(toastType == "success" ? "bg-success text-white" : "bg-danger text-white")">
                <i class="fas @(toastType == "success" ? "fa-check-circle" : "fa-exclamation-circle") me-2"></i>
                <strong class="me-auto">@(toastType == "success" ? "Sucesso" : "Erro")</strong>
                <button type="button" class="btn-close btn-close-white" @onclick="FecharToast"></button>
            </div>
            <div class="toast-body">
                @toastMessage
            </div>
        </div>
    </div>
}

@code {
    // CLASSE CORRIGIDA - Mudei o nome para evitar conflito
    public class ApartamentoModel
    {
        public int IdApartamento { get; set; }
        public int? Torre { get; set; }
        public string Bloco { get; set; } = string.Empty;
        public string Numero { get; set; } = string.Empty;
    }

    private List<ApartamentoModel> apartamentos = new();
    private ApartamentoModel apartamentoEdit = new();
    private bool showModal = false;
    private bool showToast = false;
    private string toastMessage = "";
    private string toastType = "success";
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        await CarregarApartamentos();
    }

    private async Task CarregarApartamentos()
    {
        try
        {
            isLoading = true;
            StateHasChanged();
            
            var response = await Http.GetAsync("api/Apartamento");
            
            if (response.IsSuccessStatusCode)
            {
                apartamentos = await response.Content.ReadFromJsonAsync<List<ApartamentoModel>>() ?? new List<ApartamentoModel>();
            }
            else
            {
                MostrarToast("Erro ao carregar apartamentos", "error");
            }
        }
        catch (Exception ex)
        {
            MostrarToast($"Erro: {ex.Message}", "error");
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private void ShowCriarModal()
    {
        apartamentoEdit = new ApartamentoModel();
        showModal = true;
    }

    private void EditarApartamento(ApartamentoModel apartamento)
    {
        apartamentoEdit = new ApartamentoModel 
        { 
            IdApartamento = apartamento.IdApartamento,
            Torre = apartamento.Torre,
            Bloco = apartamento.Bloco,
            Numero = apartamento.Numero
        };
        showModal = true;
    }

    private async Task SalvarApartamento()
    {
        if (string.IsNullOrWhiteSpace(apartamentoEdit.Bloco) || string.IsNullOrWhiteSpace(apartamentoEdit.Numero))
        {
            MostrarToast("Preencha todos os campos obrigatórios!", "error");
            return;
        }

        try
        {
            if (apartamentoEdit.IdApartamento == 0)
            {
                // POST - Criar novo (a API vai gerar o ID)
                var response = await Http.PostAsJsonAsync("api/Apartamento", apartamentoEdit);
                
                if (response.IsSuccessStatusCode)
                {
                    MostrarToast("Apartamento criado com sucesso!", "success");
                    showModal = false;
                    await CarregarApartamentos();
                }
                else
                {
                    MostrarToast("Erro ao criar apartamento", "error");
                }
            }
            else
            {
                // PUT - Atualizar existente
                var response = await Http.PutAsJsonAsync($"api/Apartamento/{apartamentoEdit.IdApartamento}", apartamentoEdit);
                
                if (response.IsSuccessStatusCode)
                {
                    MostrarToast("Apartamento atualizado com sucesso!", "success");
                    showModal = false;
                    await CarregarApartamentos();
                }
                else
                {
                    MostrarToast("Erro ao atualizar apartamento", "error");
                }
            }
        }
        catch (Exception ex)
        {
            MostrarToast($"Erro: {ex.Message}", "error");
        }
    }

    private async Task DeletarApartamento(int id)
    {
        var confirmed = await JSRuntime.InvokeAsync<bool>("confirm", "Tem certeza que deseja excluir este apartamento?");
        if (confirmed)
        {
            try
            {
                var response = await Http.DeleteAsync($"api/Apartamento/{id}");
                
                if (response.IsSuccessStatusCode)
                {
                    MostrarToast("Apartamento excluído com sucesso!", "success");
                    await CarregarApartamentos();
                }
                else
                {
                    MostrarToast("Erro ao excluir apartamento", "error");
                }
            }
            catch (Exception ex)
            {
                MostrarToast($"Erro: {ex.Message}", "error");
            }
        }
    }

    private void FecharModal()
    {
        showModal = false;
    }

    private void MostrarToast(string mensagem, string tipo)
    {
        toastMessage = mensagem;
        toastType = tipo;
        showToast = true;
        StateHasChanged();
    }

    private void FecharToast()
    {
        showToast = false;
        StateHasChanged();
    }
}